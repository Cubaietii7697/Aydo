; AydoKernelDriver.inf

[Version]
Signature   = "$WINDOWS NT$"
Class       = System 
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = AydoKernelDriver.cat
DriverVer   = 09/25/2025,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AydoKernelDriver.sys = 1

;*****************************************
; Install Section
;*****************************************
; amd64 ->64bits | amd32 ->32bits
[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299 

[Standard.NTamd64.10.0...16299]
%AydoKernelDriver.DeviceDesc% = AydoKernelDriver_Device, Root\AydoKernelDriver

[AydoKernelDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
AydoKernelDriver.sys

;-------------- Service installation
[AydoKernelDriver_Device.NT.Services]
AddService = AydoKernelDriver,%SPSVCINST_ASSOCSERVICE%, AydoKernelDriver_Service_Inst

; -------------- AydoKernelDriver driver install sections
[AydoKernelDriver_Service_Inst]
DisplayName    = %AydoKernelDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\AydoKernelDriver.sys

[AydoKernelDriver_Device.NT.Wdf]
KmdfService = AydoKernelDriver, AydoKernelDriver_wdfsect

[AydoKernelDriver_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "Aydo"
DiskName               = "AydoKernelDriver Installation Disk"
AydoKernelDriver.DeviceDesc = "Aydo Device"
AydoKernelDriver.SVCDESC   = "Aydo Service"
